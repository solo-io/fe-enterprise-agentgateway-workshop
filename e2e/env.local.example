# Credentials for the e2e harness and the evaluation agent.
#
# Copy this file, then fill in the keys you have:
#
#   cp e2e/env.local.example e2e/.env.local
#   chmod 600 e2e/.env.local
#
# e2e/.env.local is gitignored. The harness sources it as shell, so quote any
# value that contains spaces or '#'. A lab whose key is missing here, in your
# shell environment, and in your shell rc file is skipped and reported as SKIP.

# Required for /evaluate: the base install fails without it.
SOLO_TRIAL_LICENSE_KEY=

# Expected for /evaluate. Most labs call OpenAI. The agent asks about it, and if
# you continue without it, those labs skip.
OPENAI_API_KEY=

# Optional. Only the mcp-tool-federation lab uses it; without it that lab skips.
FRED_API_KEY=
